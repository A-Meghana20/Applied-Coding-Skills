class Solution {
    public int[] finalPrices(int[] prices) {

        int n = prices.length;
        int[] answer = new int[n];

        for (int i = 0; i < n; i++) {

            // Initially, no discount
            answer[i] = prices[i];

            // Search for discount on the right side
            for (int j = i + 1; j < n; j++) {

                // If we find the first smaller or equal price
                if (prices[j] <= prices[i]) {

                    answer[i] = prices[i] - prices[j];

                    // Stop because we need the FIRST such price
                    break;
                }
            }
        }

        return answer;
    }
}
