import java.util.*;

class Solution {
    public int[] shortestAlternatingPaths(int n, int[][] redEdges, int[][] blueEdges) {
        List<Integer>[] redGraph = new ArrayList[n];
        List<Integer>[] blueGraph = new ArrayList[n];

        for (int i = 0; i < n; i++) {
            redGraph[i] = new ArrayList<>();
            blueGraph[i] = new ArrayList<>();
        }

        for (int[] edge : redEdges) {
            redGraph[edge[0]].add(edge[1]);
        }

        for (int[] edge : blueEdges) {
            blueGraph[edge[0]].add(edge[1]);
        }

        int[] answer = new int[n];
        Arrays.fill(answer, -1);

        boolean[][] visited = new boolean[n][2];
        Queue<int[]> queue = new LinkedList<>();

        // Color 0 = red, color 1 = blue
        // Start with both possible previous colors
        queue.offer(new int[]{0, 0, 0});
        queue.offer(new int[]{0, 1, 0});

        visited[0][0] = true;
        visited[0][1] = true;

        while (!queue.isEmpty()) {
            int[] current = queue.poll();

            int node = current[0];
            int lastColor = current[1];
            int distance = current[2];

            if (answer[node] == -1 || distance < answer[node]) {
                answer[node] = distance;
            }

            if (lastColor == 0) {
                // Last edge was red, so next edge must be blue
                for (int next : blueGraph[node]) {
                    if (!visited[next][1]) {
                        visited[next][1] = true;
                        queue.offer(new int[]{next, 1, distance + 1});
                    }
                }
            } else {
                // Last edge was blue, so next edge must be red
                for (int next : redGraph[node]) {
                    if (!visited[next][0]) {
                        visited[next][0] = true;
                        queue.offer(new int[]{next, 0, distance + 1});
                    }
                }
            }
        }

        return answer;
    }
}
